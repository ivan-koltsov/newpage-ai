# ─── API Keys Required (Provide at least one) ───────────
ANTHROPIC_API_KEY=your-anthropic-key-here
GEMINI_API_KEY=your-gemini-key-here
OPENAI_API_KEY=your-openai-key-here

# ─── Optional (defaults shown) ───────────────────────────
# If using Anthropic:
# LLM_MODEL=claude-3-5-haiku-latest

# If using Gemini:
# LLM_MODEL=gemini-flash-latest
# EMBEDDING_MODEL=gemini-embedding-2

# If using OpenAI:
# LLM_MODEL=gpt-4o-mini
# EMBEDDING_MODEL=text-embedding-3-small

# ─── LLM Provider Selection ─────────────────────────────
# Active provider choice: "openai" | "gemini" | "anthropic"
LLM_PROVIDER=gemini

# ─── Model Configuration (Specific per Provider) ────────

# Anthropic Configuration (Anthropic does not offer native embedding models)
ANTHROPIC_LLM_MODEL=claude-3-5-haiku-latest

# Gemini Configuration
GEMINI_LLM_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# OpenAI Configuration
OPENAI_LLM_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small